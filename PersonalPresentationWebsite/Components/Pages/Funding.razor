@page "/funding"
@inject FundingSettings FundingSettings

<PageTitle>Mlendea Horațiu</PageTitle>

<HeadContent>
    <meta name="description" content="Mlendea Horatiu funding page">
    <meta name="author" content="Mlendea Horatiu">
    <link rel="canonical" href="https://hmlendea.go.ro/funding/">
</HeadContent>

        <!-- Navigation-->
        <nav class="navbar navbar-expand-lg bg-secondary text-uppercase" id="mainNav">
            <div class="container">
                <a class="navbar-brand" href="/" data-enhance-nav="false">Mlendea Horațiu</a>
                <button class="navbar-toggler text-uppercase fw-bold bg-primary text-white rounded" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
                    My work
                    <i class="fas fa-bars"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarResponsive">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item mx-0 mx-lg-1">
                            <a class="nav-link py-3 px-0 px-lg-3 rounded js-scroll-trigger" href="https://github.com/hmlendea">
                                <i class="fab fa-fw fa-github"></i> GitHub
                            </a>
                        </li>
                        <li class="nav-item mx-0 mx-lg-1">
                            <a class="nav-link py-3 px-0 px-lg-3 rounded js-scroll-trigger" href="https://hori873.deviantart.com">
                                <i class="fab fa-fw fa-deviantart"></i> DeviantArt
                            </a>
                        </li>
                        <li class="nav-item mx-0 mx-lg-1">
                            <a class="nav-link py-3 px-0 px-lg-3 rounded js-scroll-trigger" href="https://steamcommunity.com/id/76561998136141589/myworkshopfiles">
                                <i class="fab fa-fw fa-steam"></i> Steam Workshop
                            </a>
                        </li>
                        <li class="nav-item mx-0 mx-lg-1">
                            <a class="nav-link py-3 px-0 px-lg-3 rounded js-scroll-trigger" href="https://nexusmods.com/users/1823210?tab=user+files">
                                <i class="fas fa-compress-arrows-alt"></i> Nexus Mods
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Funding Section-->
        <section class="page-section portfolio" id="portfolio">
            <div class="container">
                <!-- About Section Content-->
                <div class="row">
                    <div class="col-lg-6 ms-auto wow animate__animated animate__slideInLeft">
                        <p>As a passionate and experienced software engineer, I have dedicated a significant portion of my time to creating and contributing to a variety of open-source projects.</p>
                        <p>I also have a strong interest in game modification and have spent countless hours tinkering with and enhancing various games to create unique and immersive experiences for players.</p>
                    </div>
                    <div class="col-lg-6 me-auto wow animate__animated animate__slideInRight">
                        <p>Whether I am working on a complex software project or modding a favorite game, I always bring my enthusiasm, creativity, and attention to detail to every task I undertake.</p>
                        <p>If you appreciate the time, effort, and dedication that goes into my work and want to support its ongoing development, I would be grateful for any contribution you might be able to make.</p>
                    </div>
                </div>
            </div>
            <div class="divider-custom"></div>
            <div class="container">
                <!-- Funding Grid Items-->
                <div id="portfolio-gallery" class="row justify-content-center">
                    @foreach (FundingChannelSettings channel in FundingSettings.Channels)
                    {
                        <div class="col-md-6 col-lg-4 mb-5 wow animate__animated animate__bounceIn">
                            @if (channel.BankTransfer is BankTransferSettings bankTransfer)
                            {
                                <div class="portfolio-item mx-auto funding-bank-trigger" data-bs-toggle="modal" data-bs-target="#@bankTransfer.ModalId">
                                    <div class="portfolio-item-caption d-flex align-items-center justify-content-center h-100 w-100">
                                        <div class="portfolio-item-caption-content text-center text-white">@channel.Name</div>
                                    </div>
                                    <img class="img-fluid" src="@channel.Image" alt="@channel.Name" />
                                </div>
                            }
                            else
                            {
                                <a href="@channel.Url">
                                    <div class="portfolio-item mx-auto">
                                        <div class="portfolio-item-caption d-flex align-items-center justify-content-center h-100 w-100">
                                            <div class="portfolio-item-caption-content text-center text-white">@channel.Name</div>
                                        </div>
                                        <img class="img-fluid" src="@channel.Image" alt="@channel.Name" />
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Bank Transfer Modals -->
        @foreach (FundingChannelSettings channel in FundingSettings.Channels)
        {
            @if (channel.BankTransfer is BankTransferSettings bankTransfer)
            {
                <div class="modal fade" id="@bankTransfer.ModalId" tabindex="-1" aria-labelledby="@($"{bankTransfer.ModalId}Label")" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="@($"{bankTransfer.ModalId}Label")">@channel.Name</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">IBAN</dt>
                                    <dd class="col-sm-8"><code>@bankTransfer.Iban</code></dd>
                                    <dt class="col-sm-4">BIC / SWIFT</dt>
                                    <dd class="col-sm-8"><code>@bankTransfer.Swift</code></dd>
                                </dl>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Scroll to Top Button (Only visible on small and extra-small screen sizes)-->
        <div class="scroll-to-top d-lg-none position-fixed">
            <a class="js-scroll-trigger d-block text-center text-white rounded" href="#page-top"><i class="fa fa-chevron-up"></i></a>
        </div>
